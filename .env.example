# Copy to .env and fill in — never commit the real .env (see .gitignore)

# --- Voice generation (TTS) ---
# Provider TBD in the audit (§4/§12) — ElevenLabs is the current candidate,
# pending verification of its Claude connector vs a direct API key.
ELEVENLABS_API_KEY=

# --- YouTube (Data API / Analytics API) ---
# OAuth 2.0 client from Google Cloud Console (see audit §13).
# Never usable from Claude's own cloud sandbox directly (network is
# allowlisted and does not include googleapis.com) — consumed by
# GitHub Actions or a local script instead.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Anthropic API (only if scripts call Claude outside this chat) ---
ANTHROPIC_API_KEY=
